{
  "mcpServers": {
    "computer-use-direct": {
      "command": "node",
      "args": [
        "/absolute/path/to/node_modules/codex-computer-use-mcp/dist/mcp-server.js"
      ],
      "lifecycle": "lazy",
      "requestTimeoutMs": 180000,
      "directTools": false,
      "debug": false
    }
  }
}
